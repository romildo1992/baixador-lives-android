<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="20dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:text="Baixador de Lives" android:textSize="24sp" android:textStyle="bold" android:textColor="@color/primary" />
            <TextView android:id="@+id/active_count" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0 ativos" />
        </LinearLayout>
        <EditText android:id="@+id/url" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="Cole o link do vídeo, live ou playlist" android:inputType="textUri" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Formato" android:layout_marginTop="12dp" />
        <Spinner android:id="@+id/format" android:layout_width="match_parent" android:layout_height="48dp" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Qualidade do vídeo" />
        <Spinner android:id="@+id/video_quality" android:layout_width="match_parent" android:layout_height="48dp" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Qualidade do MP3" />
        <Spinner android:id="@+id/audio_quality" android:layout_width="match_parent" android:layout_height="48dp" />
        <EditText android:id="@+id/playlist_items" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="Playlist: itens 1,3-5 (vazio = completa)" android:inputType="text" />
        <EditText android:id="@+id/folder" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="Nome da pasta em Downloads" android:text="Baixador Lives" />
        <TextView android:id="@+id/destination" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Destino: Downloads/Baixador Lives" android:paddingTop="6dp" android:paddingBottom="10dp" />
        <Button android:id="@+id/download" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Baixar arquivo" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <Button android:id="@+id/pause" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Pausar" />
            <Button android:id="@+id/resume" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Continuar" />
        </LinearLayout>
        <Button android:id="@+id/finalize" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Finalizar live até aqui" />
        <ProgressBar android:id="@+id/progress" style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent" android:layout_height="12dp" android:max="100" android:layout_marginTop="14dp" />
        <TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Aguardando um link…" android:padding="10dp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Downloads" android:textSize="20sp" android:textStyle="bold" />
            <Button android:id="@+id/clear" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Limpar lista" />
        </LinearLayout>
        <TextView android:id="@+id/history" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Nenhum download nesta sessão." android:padding="10dp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Baixe somente conteúdo próprio ou autorizado." android:textSize="12sp" android:gravity="center" android:padding="16dp" />
    </LinearLayout>
</ScrollView>
